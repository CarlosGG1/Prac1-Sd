# Interfaz web de la ESTACION: Monitor + Engine (C) + una web en Python/Flask que los maneja
FROM gcc:latest
RUN apt-get update && apt-get install -y --no-install-recommends librdkafka-dev python3 python3-flask \
    && rm -rf /var/lib/apt/lists/*
COPY monitor/WM_WS_M.c estacion/WM_WS_E.c common/wm_kafka.h /tmp/
RUN gcc /tmp/WM_WS_M.c -o /usr/local/bin/WM_WS_M -lrdkafka \
    && gcc /tmp/WM_WS_E.c -o /usr/local/bin/WM_WS_E -lrdkafka -pthread
WORKDIR /app
COPY web/skin.py estacion/app_estacion.py ./
COPY web/templates ./templates
COPY web/static ./static
ENV BROKER_HOST=127.0.0.1 BROKER_PORT=9092 CENTRAL_HOST=127.0.0.1 CENTRAL_PORT=8080 \
    STATION_ID=WS-01 STATION_LOCATION="Sin ubicacion" MONITOR_PORT=5000 WEB_PORT=5200 PYTHONUNBUFFERED=1
EXPOSE 5200
CMD ["python3", "app_estacion.py"]
