# Interfaz web del OPERARIO: WM_FO (C) + una web en Python/Flask que lo maneja
FROM gcc:latest
RUN apt-get update && apt-get install -y --no-install-recommends librdkafka-dev python3 python3-flask \
    && rm -rf /var/lib/apt/lists/*
COPY operario/WM_FO.c common/wm_kafka.h /tmp/
RUN gcc /tmp/WM_FO.c -o /usr/local/bin/WM_FO -lrdkafka -pthread
WORKDIR /app
COPY web/skin.py operario/app_operario.py ./
COPY web/templates ./templates
COPY web/static ./static
ENV BROKER_HOST=127.0.0.1 BROKER_PORT=9092 OPERARIO=OP-1 WEB_PORT=5100 PYTHONUNBUFFERED=1
EXPOSE 5100
CMD ["python3", "app_operario.py"]
